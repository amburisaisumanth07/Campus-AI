# ==============================================================================
# CampusAI Environment Configuration Template
# Copy to .env for local development or configure in your production platform.
# NEVER commit the actual .env file.
# ==============================================================================

# Application & Server Settings
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# CORS Configuration (comma-separated allowed origins; in production, use your deployed frontend domain)
CORS_ORIGINS=http://localhost:5173

# Database configuration (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://campus_user:campus_password@localhost:5432/campus_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication
# IMPORTANT FOR PRODUCTION: Generate a cryptographically secure 256-bit random key:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin Seed Account (Local dev only – leave blank in production to prevent auto-seeding)
ADMIN_EMAIL=admin@campusai.test
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=CampusAI Admin

# Document Storage (Local path or persistent volume mount in container)
DOCUMENT_STORAGE_PATH=data/documents
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=2048

# Chroma Vector Store Configuration
# For local Docker: host=localhost (or container name), port=8001, ssl=false
# For hosted/remote HTTPS: host=chroma.yourdomain.com, port=443, ssl=true
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=
CHROMA_COLLECTION=campus_docs

# RAG Retrieval & Tuning Parameters
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.0
