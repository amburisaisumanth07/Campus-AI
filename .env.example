# Database configuration
DATABASE_URL=postgresql+psycopg://campus_user:campus_password@localhost:5432/campus_db
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Authentication – generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin seed (for local dev only – leave blank to skip seeding)
ADMIN_EMAIL=admin@campusai.test
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=CampusAI Admin

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chroma Vector Store Configuration (Docker service)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=campus_docs

# RAG Tuning Parameters
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.0
